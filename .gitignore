# ===== 构建产物 =====
build/
build-sim/
build-sim-release/
derive/
DerivedData/
Cores/.build/
*.dSYM/
*.xcresult/
*.xcarchive/

# 交付产物（ipa 在本地 dist/ 保留，不入库）
dist/

# ===== 本地工具（按需下载，可重新获取）=====
Tools/vendor/

# ===== Xcode 用户数据 =====
*.xcuserstate
xcuserdata/
*.xcscmblueprint

# ===== macOS / 编辑器 =====
.DS_Store
*.swp
.idea/

# ===== Python =====
__pycache__/
*.pyc

# ===== 日志 / 临时 =====
*.log
*.tmp
*.bak

# 说明：*.xcodeproj 不忽略——XcodeGen 生成物提交入库，
# 保证没有 XcodeGen 的环境也能直接打开工程

# FBNeo 街机核心（99MB，体积过大不入库）：
# 缺失时 ./Tools/build.sh 会自动执行 ./Tools/build_cores.sh fbneo 补建（首次约 40 分钟）
Cores/artifacts/fbneo-core.xcframework/

# ===== 内部工作区（含开发日志与个人偏好，不对外发布）=====
.workbuddy/
